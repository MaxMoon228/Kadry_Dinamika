# Источник данных фронтенда:
#   mock  — синтетические демо-данные в браузере (по умолчанию, реальный датасет не нужен)
#   local — реальный датасет из public/data/real-dataset.json (так собирается GitHub Pages;
#           пересобрать: python scripts/real-data/build_real_dataset.py --src "D:/CU/KAdri")
#   api   — REST API backend (FastAPI), см. docs/API_CONTRACT.md
VITE_DATA_SOURCE=mock

# Базовый URL API (используется при VITE_DATA_SOURCE=api)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Искусственная задержка mock-ответов, мс (проверка loading-состояний)
VITE_MOCK_LATENCY_MS=250

# Секреты во frontend не хранятся: токены выдаёт IdP, авторизацию выполняет backend.
